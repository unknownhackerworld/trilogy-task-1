# Speech Translator — Environment Configuration
# Copy to .env and fill in values as needed.

# ASR Engine: "whisper" (free, local) or "deepgram" (paid, cloud)
ASR_ENGINE=deepgram

# Whisper model size: tiny, base, small, medium, large-v3
# Smaller = faster, less accurate. "base" is recommended default.
WHISPER_MODEL=base

# Deepgram API Key (only if ASR_ENGINE=deepgram)
DEEPGRAM_API_KEY=d7c0327938cb1cd5e6fdfff12260d8377f8e9f01

# Translation Engine: "libre" (free) or "google" (paid)
TRANSLATION_ENGINE=libre

# Google Translate API Key (only if TRANSLATION_ENGINE=google)
GOOGLE_TRANSLATE_API_KEY=

# LibreTranslate instance URL (default: public instance)
LIBRE_TRANSLATE_URL=https://libretranslate.com
